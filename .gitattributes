# Mặc định: Git tự nhận diện file text và luôn dùng LF
* text=auto eol=lf

# Script Windows bắt buộc CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# File nhị phân: không đụng tới
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
